<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="500.0" prefWidth="850.0" xmlns="http://javafx.com/javafx/17.0.14" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jelena.etfbl.smartvillage.app.PregledZaposlenihController">
    <children>
        <Label layoutX="346.0" layoutY="20.0" text="Upravljanje zaposlenima zadruge">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <TableView fx:id="zaposleni_tableView" layoutX="25.0" layoutY="65.0" prefHeight="340.0" prefWidth="480.0">
            <columns>
                <TableColumn fx:id="jmb_col" prefWidth="100.0" text="JMB" />
                <TableColumn fx:id="ime_col" prefWidth="90.0" text="Ime" />
                <TableColumn fx:id="prezime_col" prefWidth="100.0" text="Prezime" />
                <TableColumn fx:id="telefon_col" prefWidth="95.0" text="Telefon" />
                <TableColumn fx:id="radnoMjesto_col" prefWidth="95.0" text="Radno mjesto" />
            </columns>
        </TableView>

        <Label layoutX="540.0" layoutY="65.0" text="Podaci o zaposlenom">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="540.0" layoutY="105.0" text="JMB:" />
        <TextField fx:id="jmb_txtField" layoutX="640.0" layoutY="101.0" prefWidth="180.0" />

        <Label layoutX="540.0" layoutY="150.0" text="Ime:" />
        <TextField fx:id="ime_txtField" layoutX="640.0" layoutY="146.0" prefWidth="180.0" />

        <Label layoutX="540.0" layoutY="195.0" text="Prezime:" />
        <TextField fx:id="prezime_txtField" layoutX="640.0" layoutY="191.0" prefWidth="180.0" />

        <Label layoutX="540.0" layoutY="240.0" text="Telefon:" />
        <TextField fx:id="telefon_txtField" layoutX="640.0" layoutY="236.0" prefWidth="180.0" />

        <Label layoutX="540.0" layoutY="285.0" text="Radno mjesto:" />
        <TextField fx:id="radnoMjesto_txtField" layoutX="640.0" layoutY="281.0" prefWidth="180.0" />

        <Label layoutX="540.0" layoutY="330.0" text="Rasporedi u HUB:" />
        <ComboBox fx:id="hub_cmbBox" layoutX="640.0" layoutY="326.0" prefWidth="180.0" />

        <Button layoutX="640.0" layoutY="375.0" mnemonicParsing="false" onAction="#pripremiZaNovog" prefWidth="180.0" text="Očisti formu (Novi zaposleni)" />

        <HBox alignment="CENTER" layoutX="25.0" layoutY="430.0" prefWidth="800.0" spacing="50.0">
            <children>
                <Button mnemonicParsing="false" onAction="#sacuvajIzmjene" prefHeight="35.0" prefWidth="140.0" text="Sačuvaj / Izmijeni" />
                <Button mnemonicParsing="false" onAction="#obrisiZaposlenog" prefHeight="35.0" prefWidth="140.0" style="-fx-text-fill: red;" text="Obriši zaposlenog" />
                <Button mnemonicParsing="false" onAction="#zatvoriProzor" prefHeight="35.0" prefWidth="140.0" text="Zatvori" />
            </children>
        </HBox>
    </children>
</Pane>
