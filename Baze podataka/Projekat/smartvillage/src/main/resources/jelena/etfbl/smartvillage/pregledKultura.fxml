<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.text.Font?>

<Pane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="480.0" prefWidth="500.0" xmlns="http://javafx.com/javafx/17.0.14" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jelena.etfbl.smartvillage.app.PregledKulturaController">
    <children>
        <Label layoutX="155.0" layoutY="20.0" text="Kulture u upotrebi u zadruzi">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <!-- Tabela za pregled -->
        <TableView fx:id="kulture_tableView" layoutX="30.0" layoutY="60.0" prefHeight="220.0" prefWidth="440.0">
            <columns>
                <TableColumn fx:id="naziv_col" prefWidth="220.0" text="Naziv kulture" />
                <TableColumn fx:id="vrsta_col" prefWidth="215.0" text="Vrsta (voće, povrće...)" />
            </columns>
        </TableView>

        <!-- Sekcija za dodavanje nove kulture -->
        <Label layoutX="30.0" layoutY="295.0" text="Dodaj novu kulturu u šifrarnik:">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <Label layoutX="30.0" layoutY="325.0" text="Naziv kulture:" />
        <TextField fx:id="noviNaziv_txtField" layoutX="120.0" layoutY="321.0" prefWidth="350.0" promptText="npr. Šljiva Požegača" />

        <Label layoutX="30.0" layoutY="365.0" text="Vrsta kulture:" />
        <TextField fx:id="novaVrsta_txtField" layoutX="120.0" layoutY="361.0" prefWidth="350.0" promptText="npr. Voće" />

        <Button layoutX="120.0" layoutY="405.0" mnemonicParsing="false" onAction="#dodajNovuKulturu" prefWidth="160.0" text="Sačuvaj kulturu" />
        <Button layoutX="310.0" layoutY="405.0" mnemonicParsing="false" onAction="#zatvoriProzor" prefWidth="160.0" text="Zatvori" />
    </children>
</Pane>