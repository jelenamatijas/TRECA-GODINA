<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.14" xmlns:fx="http://javafx.com/fxml/1" fx:controller="jelena.etfbl.smartvillage.app.IzmjeniZadrugaraController">
    <children>
        <Label layoutX="306.0" layoutY="30.0" text="Izmjena podataka zadrugara">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>

        <Label layoutX="40.0" layoutY="74.0" text="JMB:" />
        <TextField fx:id="jmb_txtField" layoutX="130.0" layoutY="70.0" prefHeight="26.0" prefWidth="230.0" style="-fx-background-color: #e0e0e0;" />

        <Label layoutX="40.0" layoutY="114.0" text="Ime:" />
        <TextField fx:id="ime_txtField" layoutX="130.0" layoutY="110.0" prefHeight="26.0" prefWidth="230.0" />

        <Label layoutX="40.0" layoutY="154.0" text="Prezime:" />
        <TextField fx:id="prezime_txtField" layoutX="130.0" layoutY="150.0" prefHeight="26.0" prefWidth="230.0" />

        <Label layoutX="425.0" layoutY="73.0" text="Telefon:" />
        <TextField fx:id="telefon_txtField" layoutX="515.0" layoutY="69.0" prefHeight="26.0" prefWidth="230.0" />

        <Label layoutX="425.0" layoutY="113.0" text="Status člana:" />
        <CheckBox fx:id="aktivan_checkBox" layoutX="515.0" layoutY="113.0" mnemonicParsing="false" text="Aktivan zadrugar" />
      <Label layoutX="38.0" layoutY="206.0" text="Pripadajuće zadruge">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <Label layoutX="545.0" layoutY="154.0" text="Pripadajuće parcele">
         <font>
            <Font name="System Bold" size="12.0" />
         </font>
      </Label>
      <ListView fx:id="zadruge_listView" layoutX="40.0" layoutY="230.0" prefHeight="350.0" prefWidth="341.0" />
      <ListView fx:id="parcele_listView" layoutX="425.0" layoutY="230.0" prefHeight="350.0" prefWidth="341.0" />
      <Button layoutX="543.0" layoutY="201.0" onAction="#obrisiParcelu" prefHeight="26.0" prefWidth="105.0" text="OBRIŠI" />
      <Button layoutX="661.0" layoutY="201.0" mnemonicParsing="false" onAction="#otvoriProzorZaNovuParcelu" prefHeight="26.0" prefWidth="105.0" text="DODAJ" />
      <Button layoutX="536.0" layoutY="607.0" mnemonicParsing="false" onAction="#spasiIzmjene" prefHeight="26.0" prefWidth="105.0" style="-fx-background-color: #a5d6a7; -fx-font-weight: bold;" text="SPASI" />
      <Button layoutX="661.0" layoutY="607.0" mnemonicParsing="false" onAction="#ponisti" prefHeight="26.0" prefWidth="105.0" text="PONIŠTI" />
      <Button layoutX="425.0" layoutY="201.0" onAction="#pregledajParcelu" prefHeight="26.0" prefWidth="105.0" text="PREGLED" />
    </children>
</AnchorPane>
